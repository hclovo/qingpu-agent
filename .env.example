# 后端
PORT=4111
WEB_ORIGIN=http://localhost:5173

# 可选：配置后 API 使用 PostgreSQL；留空时使用进程内存储
DATABASE_URL=
# DATABASE_URL=postgres://qingpu:qingpu@localhost:5432/qingpu_agent
DATABASE_POOL_SIZE=10

# Mastra 模型路由，格式为 provider/model-name
MASTRA_MODEL=openai/gpt-4o-mini

# OpenAI 或 OpenAI 兼容服务。官方 OpenAI 可将 BASE_URL 留空。
# 自定义地址应包含服务要求的版本路径，例如 https://gateway.example.com/v1
OPENAI_BASE_URL=
OPENAI_API_KEY=

# 可选：使用其他模型提供方时配置对应密钥
ANTHROPIC_API_KEY=
GOOGLE_GENERATIVE_AI_API_KEY=
