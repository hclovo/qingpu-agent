# 后端
PORT=4111
WEB_ORIGIN=http://localhost:5173

# 可选：配置后 API 使用 PostgreSQL；留空时使用进程内存储
DATABASE_URL=
# DATABASE_URL=postgres://qingpu:qingpu@localhost:5432/qingpu_agent
DATABASE_POOL_SIZE=10

# 认证开关。true 强制登录；false 允许游客只读查看（不能用 Agent、不能改知识库或发现商机）。
# 未设置时：仅当已配置 DATABASE_URL 且 NODE_ENV=production 才强制登录。
AUTH_REQUIRED=false
# 会话绝对有效期与空闲过期（小时）
SESSION_TTL_HOURS=12
SESSION_IDLE_HOURS=4
# 种子账号（本地/演示）：admin@qingpu.local / QingpuAdmin!26
# sales@qingpu.local / QingpuSales!26
# viewer@qingpu.local / QingpuViewer!26

# Mastra 模型路由，格式为 provider/model-name
MASTRA_MODEL=openai/gpt-4o-mini

# OpenAI 或 OpenAI 兼容服务。官方 OpenAI 可将 BASE_URL 留空。
# 自定义地址应包含服务要求的版本路径，例如 https://gateway.example.com/v1
OPENAI_BASE_URL=
OPENAI_API_KEY=

# Tavily 实时搜索服务密钥（https://tavily.com）。商机发现会同时走新闻检索与招标/政策/行业站点检索。不配置则降级为演示模式。
TAVILY_API_KEY=

# 可选：Agent 单次调用超时（毫秒），默认 45000。推理型模型偏慢时可上调。
# AGENT_TIMEOUT_MS=45000
# 可选：商机发现抽取超时（毫秒）。检索已在 Agent 外并行完成，默认比 AGENT_TIMEOUT_MS 多 45000。
# DISCOVER_TIMEOUT_MS=90000

# 可选：使用其他模型提供方时配置对应密钥
ANTHROPIC_API_KEY=
GOOGLE_GENERATIVE_AI_API_KEY=
